# PostgreSQL 17 + PostGIS connection
# Each project uses its own database on the shared PG17 instance
DATABASE_URL=postgresql://user@localhost:5432/geostack

# For another project: create a new database and point here
# For other projects: create a new DB and point here

# Census API key (free from https://api.census.gov/data/key_signup.html)
CENSUS_API_KEY=

# Optional: OSRM server URL (default: public demo, rate-limited)
# Self-host for production: https://github.com/Project-OSRM/osrm-backend
OSRM_BASE_URL=https://router.project-osrm.org
